<launch>
  <arg name="mode" default="simulation" />
  <arg name="ego_execution_mode" default="simulation" />
  <arg
    name="start_platform_comm"
    default="$(eval arg('mode') == 'hybrid')"
  />
  <arg
    name="start_ego_adapter"
    default="$(eval arg('ego_execution_mode') == 'external')"
  />

  <!--
    Single-experiment worker. The manager has already loaded and updated all
    parameters. Runtime is required so its exit closes the optional adapters
    and evaluator while the persistent manager remains alive.
  -->
  <group ns="autoscene">
    <node
      pkg="autoscene_runtime"
      type="scenario_runtime_node.py"
      name="scenario_runtime_node"
      output="screen"
      required="true"
    />

    <node
      if="$(arg start_ego_adapter)"
      pkg="autoscene_ego"
      type="ego_adapter_node.py"
      name="ego_adapter_node"
      output="screen"
    />

    <node
      if="$(arg start_platform_comm)"
      pkg="autoscene_platform"
      type="platform_comm_node.py"
      name="platform_comm_node"
      output="screen"
    />

    <node
      pkg="autoscene_evaluation"
      type="evaluator_node.py"
      name="evaluator_node"
      output="screen"
    />
  </group>
</launch>
