<launch>
  <arg name="config" />
  <rosparam command="load" file="$(arg config)" />
  <group ns="autoscene">
    <node pkg="autoscene_experiment" type="experiment_manager_node.py" name="experiment_manager_node" output="screen" required="true">
      <param name="config_path" value="$(arg config)" />
      <param name="expected_mode" value="hybrid" />
      <param name="manage_nodes" value="true" />
      <param name="interactive_console" value="false" />
      <param name="auto_start_after_prepare" value="false" />
      <param name="launch_in_terminal" value="false" />
      <param name="worker_launch" value="delivery_workers.launch" />
    </node>
  </group>
</launch>
